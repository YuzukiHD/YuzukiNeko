{
  "arch": "riscv32",
  "cpu": "generic-rv32",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:32:32-i64:64-n32-S128",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "features": "+m,+a,+c,+zba,+zbb,+zbc,+zbs,+zicond,+zicbom,+zicbop,+zicboz,+zihintntl,+zihintpause,+zawrs,+zicsr,+zifencei,+zicntr,+zihpm,-unaligned-vector-mem,-v,-xtheadvdot,-zvbb,-zvbc,-zve32f,-zve32x,-zve64d,-zve64f,-zve64x,-zvfbfmin,-zvfbfwma,-zvfh,-zvfhmin,-zvkb,-zvkg,-zvkn,-zvknc,-zvkned,-zvkng,-zvknha,-zvknhb,-zvks,-zvksc,-zvksed,-zvksg,-zvksh,-zvkt,-zvl1024b,-zvl128b,-zvl16384b,-zvl2048b,-zvl256b,-zvl32768b,-zvl32b,-zvl4096b,-zvl512b,-zvl64b,-zvl65536b,-zvl8192b",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "ilp32",
  "llvm-target": "riscv32",
  "max-atomic-width": 32,
  "metadata": {
    "description": "Neko F101 RV32 scalar extensions, ILP32 ABI, no vector",
    "host_tools": false,
    "std": false
  },
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-pointer-width": 32
}
