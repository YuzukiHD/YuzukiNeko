[2.734459, "o", "  Print environment variables (FEATURE_RESIZE_PRINT) [Y/n/?] (NEW) y\r\n"]
[2.734499, "o", "setconsole (3.8 kb) (SETCONSOLE) [Y/n/?] (NEW) y\r\n"]
[2.734595, "o", "  Enable long options (FEATURE_SETCONSOLE_LONG_OPTIONS) [Y/n] (NEW) y\r\nsetkeycodes (2.4 kb) (SETKEYCODES) [Y/n/?] (NEW) y\r\nsetlogcons (2 kb) (SETLOGCONS) [Y/n/?] (NEW) y\r\nshowkey (4.9 kb) (SHOWKEY) [Y/n/?] (NEW) y\r\n*\r\n* Debian Utilities\r\n*\r\npipe_progress (576 bytes) (PIPE_PROGRESS) [Y/n/?] (NEW) y\r\n"]
