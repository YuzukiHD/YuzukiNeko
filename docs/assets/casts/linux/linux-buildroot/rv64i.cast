[129.458234, "o", "# --enable-maintainer-mode to rebuild ../../libcody/config.h.in, or make MAINTAINER=touch\r\n"]
[328.344273, "o", "# If this is the top-level multilib, build all the other\r\n"]
[328.346619, "o", "# multilibs.\r\n"]
[330.644495, "o", "# Early copyback; see \"all\" above for the rationale.  The\r\n"]
[330.646658, "o", "# early copy is necessary so that the gcc -B options find\r\n"]
[330.648488, "o", "# the right startup files when linking shared libgcc.\r\n"]
[331.358837, "o", "# Now that we have built all the objects, we need to copy\r\n"]
[331.360897, "o", "# them back to the GCC directory.  Too many things (other\r\n"]
[331.362736, "o", "# in-tree libraries, and DejaGNU) know about the layout\r\n"]
[331.364465, "o", "# of the build tree, for now.\r\n"]
