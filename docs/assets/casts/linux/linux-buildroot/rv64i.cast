[372.115348, "o", "\u001b[7m>>> host-gcc-final 15.3.0 Updating config.sub and config.guess\u001b[27m\r\n"]
[372.259324, "o", "\u001b[7m>>> host-gcc-final 15.3.0 Patching libtool\u001b[27m\r\n"]
[372.346882, "o", "\u001b[7m>>> host-gcc-final 15.3.0 Configuring\u001b[27m\r\n"]
[373.777733, "o", "\u001b[7m>>> host-gcc-final 15.3.0 Building\u001b[27m\r\n"]
[376.801736, "o", "# --enable-maintainer-mode to rebuild ../../libcody/config.h.in, or make MAINTAINER=touch\r\n"]
[580.761518, "o", "# If this is the top-level multilib, build all the other\r\n"]
[580.762738, "o", "# multilibs.\r\n"]
[583.781938, "o", "# Early copyback; see \"all\" above for the rationale.  The\r\n"]
[583.782769, "o", "# early copy is necessary so that the gcc -B options find\r\n"]
[583.783674, "o", "# the right startup files when linking shared libgcc.\r\n"]
[584.141464, "o", "# @multilib_flags@ is still needed because this may use\r\n"]
[584.142334, "o", "# /home/user/f101-linux/build/br-rv64i/build/host-gcc-final-15.3.0/build/./gcc/xgcc -B/home/user/f101-linux/build/br-rv64i/build/host-gcc-final-15.3.0/build/./gcc/ -B/home/user/f101-linux/build/br-rv64i/host/riscv64-buildroot-linux-musl/bin/ -B/home/user/f101-linux/build/br-rv64i/host/riscv64-buildroot-linux-musl/lib/ -isystem /home/user/f101-linux/build/br-rv64i/host/riscv64-buildroot-linux-musl/include -isystem /home/user/f101-linux/build/br-rv64i/host/riscv64-buildroot-linux-musl/sys-include    and -O2  -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64  -O2 -g0   -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE  -W -Wall -Wno-error=narrowing -Wwrite-strings -Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wold-style-definition  -isystem ./include  -fPIC -DGTHREAD_USE_WEAK=0 -g -DIN_LIBGCC2 -fbuilding-libgcc -fno-stack-protector  directly.\r\n"]
[584.143054, "o", "# @multilib_dir@ is not really necessary, but sometimes it has\r\n"]
[584.143742, "o", "# more uses than just a directory name.\r\n"]
[584.176658, "o", "# Now that we have built all the objects, we need to copy\r\n"]
[584.177469, "o", "# them back to the GCC directory.  Too many things (other\r\n"]
[584.178188, "o", "# in-tree libraries, and DejaGNU) know about the layout\r\n"]
[584.178959, "o", "# of the build tree, for now.\r\n"]
