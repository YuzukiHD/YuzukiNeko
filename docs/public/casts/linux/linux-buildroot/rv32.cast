[129.313045, "o", "# --enable-maintainer-mode to rebuild ../../libcody/config.h.in, or make MAINTAINER=touch\r\n"]
[328.585372, "o", "# If this is the top-level multilib, build all the other\r\n"]
[328.587358, "o", "# multilibs.\r\n"]
[330.875819, "o", "# Early copyback; see \"all\" above for the rationale.  The\r\n"]
[330.877594, "o", "# early copy is necessary so that the gcc -B options find\r\n"]
[330.879011, "o", "# the right startup files when linking shared libgcc.\r\n"]
[331.52192, "o", "# Now that we have built all the objects, we need to copy\r\n"]
[331.523263, "o", "# them back to the GCC directory.  Too many things (other\r\n"]
[331.524318, "o", "# in-tree libraries, and DejaGNU) know about the layout\r\n"]
[331.525404, "o", "# of the build tree, for now.\r\n"]
